{
  "models": [
    {
      "name": "signal",
      "role": "primary-brain",
      "description": "Big primary model (the agent brain): deep work, 98k ctx, two GPUs.",
      "gguf": "/path/to/models/big-model.Q6_K.gguf",
      "mmproj": "/path/to/models/big-model.mmproj-f16.gguf",
      "min_free_vram_gb": 27.4,
      "load_timeout_s": 420,
      "args": [
        "--mmproj",
        "/path/to/models/big-model.mmproj-f16.gguf",
        "--chat-template-file",
        "/path/to/models/big-model.chat-template.jinja",
        "--chat-template-kwargs",
        "{\"reasoning_effort\": \"xhigh\", \"preserve_thinking\": true}",
        "-c",
        "98304",
        "-ctk",
        "q8_0",
        "-ctv",
        "q8_0",
        "-np",
        "1",
        "-fit",
        "off",
        "--reasoning-format",
        "auto",
        "--device",
        "CUDA0,CUDA1",
        "-mg",
        "0",
        "-ts",
        "0.502,0.498",
        "-lm",
        "dio",
        "-ctxcp",
        "8",
        "-b",
        "2048",
        "-ub",
        "512",
        "--spec-type",
        "draft-mtp",
        "--spec-draft-n-max",
        "5",
        "--no-spec-draft-backend-sampling",
        "-ctkd",
        "f16",
        "-ctvd",
        "f16",
        "--temp",
        "1.0",
        "--top-p",
        "0.95",
        "--top-k",
        "20",
        "--min-p",
        "0.0",
        "--presence-penalty",
        "0.0",
        "--repeat-penalty",
        "1.0",
        "--metrics"
      ],
      "engine": "llamacpp",
      "presets": {},
      "active_preset": null
    },
    {
      "name": "qwen",
      "role": "image-tasks",
      "description": "Small model: quick chat/voice and room for GPU jobs (ComfyUI). Same 98k ctx as the primary.",
      "gguf": "/path/to/models/small-model.Q5_K_M.gguf",
      "mmproj": "/path/to/models/small-model.mmproj-f32.gguf",
      "min_free_vram_gb": 11.6,
      "load_timeout_s": 300,
      "args": [
        "--mmproj",
        "/path/to/models/small-model.mmproj-f32.gguf",
        "-fit",
        "off",
        "-ts",
        "1.100,0.900",
        "-c",
        "98304",
        "-ctk",
        "q8_0",
        "-ctv",
        "q8_0",
        "--temp",
        "1.0",
        "--min-p",
        "0.05",
        "--top-p",
        "0.95",
        "--top-k",
        "40",
        "--repeat-penalty",
        "1.1"
      ],
      "engine": "llamacpp",
      "presets": {},
      "active_preset": null
    }
  ],
  "active_engine": "llamacpp",
  "version": 2,
  "engines": {
    "llamacpp": {
      "bin": "~/llama.cpp/build/bin/llama-server",
      "host": "127.0.0.1",
      "port": 8080,
      "common_args": [
        "-ngl",
        "99",
        "--jinja",
        "--no-warmup",
        "--flash-attn",
        "on",
        "-sm",
        "tensor",
        "-lzm",
        "on",
        "-t",
        "10",
        "--metrics"
      ],
      "env": {
        "CUDA_VISIBLE_DEVICES": "0,1"
      }
    },
    "ollama": {
      "host": "127.0.0.1",
      "port": 11434,
      "bin": "",
      "env": {},
      "common_args": []
    },
    "vllm": {
      "host": "127.0.0.1",
      "port": 8000,
      "bin": "",
      "env": {},
      "common_args": []
    },
    "lmstudio": {
      "host": "127.0.0.1",
      "port": 1234,
      "bin": "",
      "env": {},
      "common_args": []
    }
  }
}
